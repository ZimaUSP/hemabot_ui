# Hemabot services configuration, read by hemabot-ros.service and hemabot-ui.service.
# Plain KEY=value lines (no shell expansion). After editing run:
#   sudo systemctl restart hemabot-ros hemabot-ui

# --- ROS 2 bringup --------------------------------------------------------------------
HEMABOT_ROS_SETUP=/opt/ros/@ROS_DISTRO@/setup.bash
HEMABOT_ROS_WS=@ROS_WS@
HEMABOT_ROS_LAUNCH_PACKAGE=minihema_launch
HEMABOT_ROS_LAUNCH_FILE=minihema_launch.py
# Extra launch arguments, e.g. use_robot_localization:=False
HEMABOT_ROS_LAUNCH_ARGS=
# Isolates the robot from other ROS 2 machines on the network. Terminals used to
# inspect the robot (ros2 topic list, ...) must export the same value.
#ROS_DOMAIN_ID=0

# --- Web UI (all options: src/hemabot_ui/config.py) ------------------------------------
HEMABOT_UI_PORT=@PORT@
HEMABOT_UI_BACKEND=ros2
HEMABOT_UI_CMD_VEL_TOPIC=/cmd_vel_joy
HEMABOT_UI_MAX_LINEAR_SPEED=0.4
HEMABOT_UI_MAX_ANGULAR_SPEED=1.0
